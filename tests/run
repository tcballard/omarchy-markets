#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python3 "$root/scripts/validate_manifest.py" "$root"
python3 -m unittest discover -s "$root/tests" -p 'test_*.py'
node "$root/tests/model.test.js"
node "$root/tests/service_lifecycle.test.js"
python3 -m py_compile "$root/scripts/fetch_quotes.py"
bash -n "$root/demo/run"
"$root/demo/run"

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$root"
fi

printf 'All portable plugin checks passed.\n'
